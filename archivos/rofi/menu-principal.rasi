/* Menu del logo: desplegable chico arriba a la izquierda, como el menu de la manzanita */
@import "config.rasi"
configuration { font: "Inter 12"; }
window { location: northwest; anchor: northwest; x-offset: 10px; y-offset: 40px; width: 380px; border-radius: 12px; padding: 6px; }
mainbox { children: [listview]; }
listview { lines: 9; border: 0; padding: 0; spacing: 0; scrollbar: false; }
element { padding: 8px 14px; border-radius: 6px; }
element-icon { size: 0; }
